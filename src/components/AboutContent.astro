<section class="about">
  <!-- <p class="eyebrow">About</p> -->
  <h1
    class="about__bio"
    data-reveal-lines
    data-line-base-delay="0.1"
    data-line-stagger="0.09"
  >
    Product&nbsp;designer with&nbsp;10+&nbsp;years of&nbsp;experience spanning interaction, visual,&nbsp;and systems&nbsp;design.
  </h1>

  <div class="about__pills">
    <a class="about__pill about__reveal" data-reveal-wait href="mailto:pavel.rakhlin@gmail.com">pavel.rakhlin@gmail.com</a>
    <a class="about__pill about__reveal" data-reveal-wait href="https://www.linkedin.com/in/pavelrakhlin/" target="_blank" rel="me noopener">LinkedIn</a>
    <a class="about__pill about__reveal" data-reveal-wait href="/resume.pdf">Resume (PDF)</a>
  </div>
</section>

<style>
  .about {
    margin-inline: 0;
  }
  .about__bio {
    width: 100%;
    max-width: none;
  }

  .about__bio-sub {
    margin: var(--space-8) 0 0;
    max-width: var(--max-width-prose);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .about__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-12);
  }

  .about__pill {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-accent);
    background: var(--color-accent-contrast);
    border: 1px solid var(--color-accent);
    border-radius: 9999px;
    opacity: 1;
    transition:
      color 0.2s var(--ease),
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .about__pill:hover {
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .about__reveal[data-reveal-wait] {
    opacity: 0;
    animation: none;
  }

  .about__reveal {
    opacity: 0;
    transform: translateY(0.6rem);
    animation: reveal-line-in 0.75s var(--ease) forwards;
    animation-delay: var(--reveal-delay, 0.22s);
  }
</style>

<script>
  import {
    REVEAL_LINES_READY,
    getHeadingRevealEndDelay,
    revealAt,
  } from '../scripts/reveal-lines';

  function initAboutPills() {
    document.querySelectorAll<HTMLElement>('.about').forEach((section) => {
      const heading = section.querySelector<HTMLElement>('[data-reveal-lines]');
      if (!heading) return;

      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      if (reduced) {
        section
          .querySelectorAll('[data-reveal-wait]')
          .forEach((el) => el.removeAttribute('data-reveal-wait'));
        return;
      }

      let delay = getHeadingRevealEndDelay(heading);

      const sub = section.querySelector<HTMLElement>('.about__bio-sub');
      if (sub) {
        revealAt(sub, delay);
        delay += 0.2;
      }

      section
        .querySelectorAll<HTMLElement>('.about__pills .about__reveal')
        .forEach((item) => {
          revealAt(item, delay);
          delay += 0.07;
        });
    });
  }

  document.addEventListener(REVEAL_LINES_READY, initAboutPills);
</script>
