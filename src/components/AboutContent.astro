<section class="about prose">
  <!-- <p class="eyebrow">About</p> -->
  <h1
    class="about__bio"
    data-reveal-lines
    data-line-base-delay="0.1"
    data-line-stagger="0.09"
  >
    Product designer with 10+ years of experience spanning interaction,
    visual, and systems design.
  </h1>

  <div class="about__pills">
    <a class="about__pill about__reveal" data-reveal-wait href="mailto:pavel.rakhlin@gmail.com">pavel.rakhlin@gmail.com</a>
    <a class="about__pill about__reveal" data-reveal-wait href="https://www.linkedin.com/in/pavelrakhlin/" target="_blank" rel="me noopener">LinkedIn</a>
    <a class="about__pill about__reveal" data-reveal-wait href="/resume.pdf">Resume (PDF)</a>
  </div>
</section>

<style>
  .about {
    margin-inline: 0;
  }
  .about__bio {
    font-size: clamp(var(--text-3xl), 3.25vw + 1rem, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .about__bio-sub {
    margin: var(--space-8) 0 0;
    max-width: var(--max-width-prose);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .about__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-12);
  }

  .about__pill {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 9999px;
    opacity: 1;
    transition:
      background 0.2s var(--ease),
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .about__pill:hover {
    color: var(--color-accent-contrast);
    background: color-mix(in srgb, var(--color-accent) 82%, var(--color-accent-contrast));
    border-color: color-mix(in srgb, var(--color-accent) 82%, var(--color-accent-contrast));
    transform: translateY(-1px);
  }

  .about__reveal[data-reveal-wait] {
    opacity: 0;
    animation: none;
  }

  .about__bio[data-reveal-lines]:not([data-reveal-lines-ready]) {
    opacity: 0;
  }

  /* Lines are built in JS — must be global to receive scoped styles. */
  :global(.about__bio-line) {
    display: block;
    opacity: 0;
    transform: translateY(0.6rem);
    animation: about-bio-in 0.75s var(--ease) forwards;
    animation-delay: var(--bio-delay, 0s);
  }

  .about__reveal {
    opacity: 0;
    transform: translateY(0.6rem);
    animation: about-bio-in 0.75s var(--ease) forwards;
    animation-delay: var(--bio-delay, 0.22s);
  }

  @keyframes about-bio-in {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about__bio[data-reveal-lines] {
      opacity: 1;
    }

    :global(.about__bio-line),
    .about__reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const prefersReduced = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function groupWordsIntoLines(container: HTMLElement) {
    const text = container.textContent?.trim() ?? '';
    if (!text) return 0;

    const words = text.split(/\s+/);
    container.replaceChildren();

    const wordSpans = words.map((word) => {
      const span = document.createElement('span');
      span.textContent = word;
      span.style.display = 'inline';
      container.appendChild(span);
      container.appendChild(document.createTextNode(' '));
      return span;
    });

    const lines: HTMLElement[][] = [];
    let current: HTMLElement[] = [];
    let lastTop = -1;

    wordSpans.forEach((span) => {
      const top = span.offsetTop;
      if (lastTop !== -1 && top > lastTop + 1) {
        lines.push(current);
        current = [];
      }
      current.push(span);
      lastTop = top;
    });
    if (current.length) lines.push(current);

    const baseDelay = Number(container.dataset.lineBaseDelay ?? 0.1);
    const stagger = Number(container.dataset.lineStagger ?? 0.09);

    container.replaceChildren();
    lines.forEach((lineWords, index) => {
      const line = document.createElement('span');
      line.className = 'about__bio-line';
      line.style.setProperty(
        '--bio-delay',
        `${baseDelay + index * stagger}s`,
      );
      lineWords.forEach((word, wordIndex) => {
        line.appendChild(word.cloneNode(true));
        if (wordIndex < lineWords.length - 1) {
          line.appendChild(document.createTextNode(' '));
        }
      });
      container.appendChild(line);
    });

    return lines.length;
  }

  function revealAt(el: HTMLElement, delay: number) {
    el.style.setProperty('--bio-delay', `${delay}s`);
    el.removeAttribute('data-reveal-wait');
  }

  function initAboutReveals() {
    document.querySelectorAll<HTMLElement>('.about').forEach((section) => {
      const heading = section.querySelector<HTMLElement>('[data-reveal-lines]');
      if (!heading) return;

      const baseDelay = Number(heading.dataset.lineBaseDelay ?? 0.1);
      const stagger = Number(heading.dataset.lineStagger ?? 0.09);

      if (prefersReduced()) {
        heading.dataset.revealLinesReady = 'true';
        heading.style.opacity = '1';
        section
          .querySelectorAll('[data-reveal-wait]')
          .forEach((el) => el.removeAttribute('data-reveal-wait'));
        return;
      }

      let delay = baseDelay;

      if (!heading.querySelector('.about__bio-line')) {
        heading.dataset.revealLinesReady = 'true';
        const lineCount = groupWordsIntoLines(heading);
        heading.style.opacity = '1';
        delay = baseDelay + lineCount * stagger + 0.12;
      } else {
        const lineCount = heading.querySelectorAll('.about__bio-line').length;
        delay = baseDelay + lineCount * stagger + 0.12;
      }

      const sub = section.querySelector<HTMLElement>('.about__bio-sub');
      if (sub) {
        revealAt(sub, delay);
        delay += 0.2;
      }

      section.querySelectorAll<HTMLElement>('.about__pills .about__reveal').forEach((item) => {
        revealAt(item, delay);
        delay += 0.07;
      });
    });
  }

  const run = () => {
    if (document.fonts?.ready) {
      document.fonts.ready.then(initAboutReveals);
    } else {
      initAboutReveals();
    }
  };

  run();
  document.addEventListener('astro:page-load', run);
</script>
