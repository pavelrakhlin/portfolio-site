---
import type { CollectionEntry } from 'astro:content';

interface Props {
  prev: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { prev, next } = Astro.props;
---

<nav class="project-nav reveal-block" data-reveal-scroll aria-label="Case study navigation">
  <a
    href={`/work/${prev.id}/`}
    class="project-nav__link"
    aria-label={`Previous case study: ${prev.data.title}`}
  >
    <span class="eyebrow project-nav__label">
      <span class="project-nav__arrow" aria-hidden="true">&larr;</span> Previous
    </span>
    <span class="project-nav__title"><span aria-hidden="true">&larr;&nbsp;</span>{prev.data.title}</span>
  </a>
  <a
    href={`/work/${next.id}/`}
    class="project-nav__link project-nav__link--next"
    aria-label={`Next case study: ${next.data.title}`}
  >
    <span class="eyebrow project-nav__label">
      Next <span class="project-nav__arrow" aria-hidden="true">&rarr;</span>
    </span>
    <span class="project-nav__title">{next.data.title}<span aria-hidden="true">&nbsp;&rarr;</span></span>
  </a>
</nav>

<style>
  .project-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .project-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .project-nav__link--next {
    text-align: right;
    align-items: flex-end;
  }
  .project-nav__title {
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  /* Mobile shows the label + arrow inline; the desktop title (which already
     carries its own arrow) takes over above 768px. */
  .project-nav__arrow {
    display: none;
  }

  @media (max-width: 768px) {
    .project-nav__title {
      display: none;
    }
    .project-nav__arrow {
      display: inline;
    }
  }
</style>
