---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="muted">© {year} Your Name. Built with Astro.</p>
    <ul>
      <li><a href="mailto:you@example.com">Email</a></li>
      <li>
        <a href="https://www.linkedin.com/" rel="me noopener" target="_blank"
          >LinkedIn</a
        >
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-24);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-8);
  }
  .site-footer p {
    margin: 0;
    font-size: var(--text-sm);
  }
  .site-footer ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }
</style>
