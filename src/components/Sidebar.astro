---
import { getProjects } from '../lib/projects';
import ThemeToggle from './ThemeToggle.astro';

const projects = await getProjects();
const path = Astro.url.pathname;
const onContact = path.startsWith('/contact');
const isCurrent = (href: string) => path === href || path === `${href}/`;
---

<!-- Mobile backdrop: fades in behind the drawer. -->
<div class="nav-backdrop" aria-hidden="true"></div>

<!-- Mobile top bar: brand + hamburger toggle. Hidden on desktop. -->
<div class="topbar">
  <a href="/" class="topbar__brand">Pavel Rakhlin</a>
  <div class="topbar__actions">
    <ThemeToggle />
    <button
      class="topbar__toggle"
      aria-expanded="false"
      aria-controls="sidebar"
      aria-label="Open navigation"
    >
      <span class="topbar__bars" aria-hidden="true"></span>
    </button>
  </div>
</div>

<aside class="sidebar" id="sidebar">
  <div class="sidebar__inner">
    <div class="sidebar__header">
      <a
        href="/"
        class="sidebar__brand"
        aria-current={path === '/' ? 'page' : undefined}>Pavel Rakhlin</a
      >
      <ThemeToggle />
    </div>

    <nav class="sidebar__nav" aria-label="Primary">
      <ul class="nav">
        <li>
          <details class="group" open>
            <summary>Work</summary>
            <div class="group__content">
              <ul class="children">
                {
                  projects.map((project) => (
                    <li>
                      <a
                        href={`/work/${project.id}/`}
                        aria-current={
                          isCurrent(`/work/${project.id}`) ? 'page' : undefined
                        }
                      >
                        {project.data.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </details>
        </li>

        <li>
          <a
            href="/about"
            class="nav__top"
            aria-current={path.startsWith('/about') ? 'page' : undefined}
            >About me</a
          >
        </li>

        <li>
          <details class="group" open={onContact}>
            <summary>Contact</summary>
            <div class="group__content">
              <ul class="children">
                <li><a href="mailto:pavel.rakhlin@gmail.com">Email</a></li>
                <li>
                  <a href="https://www.linkedin.com/" target="_blank" rel="me noopener"
                    >LinkedIn</a
                  >
                </li>
                <li>
                  <a href="https://www.instagram.com/" target="_blank" rel="me noopener"
                    >Instagram</a
                  >
                </li>
              </ul>
            </div>
          </details>
        </li>
      </ul>
    </nav>
  </div>
</aside>

<script>
  import { navigate } from 'astro:transitions/client';

  const prefersReduced = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Remember each group's open state across View Transition navigations so a
  // tab stays expanded/collapsed based on the user's last click, not the
  // route-derived `open` default. This module persists across navigations.
  const openState = new Map<string, boolean>();

  // Smoothly animate <details> open/close by tweening the content height.
  // Falls back to instant toggle under reduced-motion.
  function setupAccordions() {
    const groups =
      document.querySelectorAll<HTMLDetailsElement>('.sidebar .group');
    groups.forEach((details) => {
      if (details.dataset.accordion === 'ready') return;
      details.dataset.accordion = 'ready';
      const summary = details.querySelector('summary');
      const content = details.querySelector<HTMLElement>('.group__content');
      if (!summary || !content) return;

      // Restore the remembered state (instant, no animation); on first sight
      // seed it from the server-rendered default.
      const key = summary.textContent?.trim() || details.dataset.accordion;
      if (openState.has(key)) {
        details.open = openState.get(key)!;
      } else {
        openState.set(key, details.open);
      }

      let animation: Animation | null = null;

      const animateOpen = () => {
        const end = content.offsetHeight;
        animation?.cancel();
        animation = content.animate(
          { height: ['0px', `${end}px`], opacity: [0, 1] },
          { duration: 320, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
        animation.onfinish = () => (animation = null);
      };

      const animateClose = () => {
        const start = content.offsetHeight;
        animation?.cancel();
        animation = content.animate(
          { height: [`${start}px`, '0px'], opacity: [1, 0] },
          { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
        animation.onfinish = () => {
          details.open = false;
          animation = null;
        };
      };

      summary.addEventListener('click', (e) => {
        if (prefersReduced()) {
          // Native instant toggle still updates the remembered state.
          openState.set(key, !details.open);
          return;
        }
        e.preventDefault();
        if (details.open) {
          openState.set(key, false);
          animateClose();
        } else {
          openState.set(key, true);
          details.open = true;
          animateOpen();
        }
      });
    });
  }

  const MOBILE = window.matchMedia('(max-width: 1024px)');
  const NAV_MS = 520;
  let navListenersReady = false;
  let navCloseTimer: ReturnType<typeof setTimeout> | null = null;

  const focusableIn = (root: HTMLElement) =>
    Array.from(
      root.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])',
      ),
    );

  const setNavOpen = (open: boolean, returnFocusToToggle = false) => {
    const btn = document.querySelector<HTMLButtonElement>('.topbar__toggle');
    const sidebar = document.getElementById('sidebar');
    const main = document.getElementById('main');
    const root = document.documentElement;
    if (!btn || !sidebar) return;

    root.classList.toggle('nav-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');

    if (!MOBILE.matches) return;

    document.body.style.overflow = open ? 'hidden' : '';
    main?.toggleAttribute('inert', open);

    if (navCloseTimer) {
      clearTimeout(navCloseTimer);
      navCloseTimer = null;
    }

    if (open) {
      sidebar.removeAttribute('inert');
    } else {
      navCloseTimer = setTimeout(() => {
        if (!root.classList.contains('nav-open')) {
          sidebar.setAttribute('inert', '');
        }
        navCloseTimer = null;
      }, NAV_MS);
    }

    if (returnFocusToToggle) {
      btn.focus();
    } else if (open) {
      focusableIn(sidebar)[0]?.focus();
    }
  };

  // Mobile drawer: open/close, scroll lock, focus trap, Escape to dismiss.
  const setupToggle = () => {
    const btn = document.querySelector<HTMLButtonElement>('.topbar__toggle');
    const sidebar = document.getElementById('sidebar');
    const root = document.documentElement;
    if (!btn || !sidebar || btn.dataset.toggle === 'ready') return;
    btn.dataset.toggle = 'ready';

    btn.addEventListener('click', () =>
      setNavOpen(!root.classList.contains('nav-open')),
    );

    const backdrop = document.querySelector('.nav-backdrop');
    backdrop?.addEventListener('click', () => setNavOpen(false, true));

    if (!navListenersReady) {
      navListenersReady = true;

      document.addEventListener(
        'click',
        (e) => {
          const sidebarEl = document.getElementById('sidebar');
          if (
            !MOBILE.matches ||
            !document.documentElement.classList.contains('nav-open') ||
            !sidebarEl
          ) {
            return;
          }
          const link = (e.target as Element).closest(
            'a[href]',
          ) as HTMLAnchorElement | null;
          if (!link || !sidebarEl.contains(link)) return;

          // Same-tab internal links would otherwise navigate instantly (via
          // the ClientRouter's own click listener) and cut the drawer's close
          // animation short. Preempt it here in the capture phase — our
          // preventDefault() must run before ClientRouter's bubble-phase
          // listener checks `ev.defaultPrevented`, or it navigates anyway.
          const isInternalNav =
            link.origin === location.origin &&
            !link.target &&
            !link.hasAttribute('download') &&
            !e.metaKey &&
            !e.ctrlKey &&
            !e.shiftKey &&
            !e.altKey;

          if (isInternalNav && !prefersReduced()) {
            e.preventDefault();
            setNavOpen(false, true);
            setTimeout(() => navigate(link.href), NAV_MS);
          } else {
            setNavOpen(false, true);
          }
        },
        true,
      );

      document.addEventListener('keydown', (e) => {
        const sidebarEl = document.getElementById('sidebar');
        const rootEl = document.documentElement;
        if (e.key === 'Escape' && rootEl.classList.contains('nav-open')) {
          e.preventDefault();
          setNavOpen(false, true);
          return;
        }
        if (
          e.key !== 'Tab' ||
          !rootEl.classList.contains('nav-open') ||
          !MOBILE.matches ||
          !sidebarEl
        ) {
          return;
        }
        const items = focusableIn(sidebarEl);
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      MOBILE.addEventListener('change', (e) => {
        const sidebarEl = document.getElementById('sidebar');
        const mainEl = document.getElementById('main');
        const rootEl = document.documentElement;
        if (e.matches) {
          sidebarEl?.toggleAttribute('inert', !rootEl.classList.contains('nav-open'));
          mainEl?.toggleAttribute('inert', rootEl.classList.contains('nav-open'));
        } else if (rootEl.classList.contains('nav-open')) {
          setNavOpen(false);
          sidebarEl?.removeAttribute('inert');
          mainEl?.removeAttribute('inert');
          document.body.style.overflow = '';
        }
      });
    }

    if (MOBILE.matches && !root.classList.contains('nav-open')) {
      sidebar.setAttribute('inert', '');
    }
  };

  const init = () => {
    setupToggle();
    setupAccordions();
  };
  init();
  document.addEventListener('astro:page-load', () => {
    const sidebar = document.getElementById('sidebar');
    const main = document.getElementById('main');
    if (navCloseTimer) {
      clearTimeout(navCloseTimer);
      navCloseTimer = null;
    }
    document.documentElement.classList.remove('nav-open');
    document.body.style.overflow = '';
    main?.removeAttribute('inert');
    if (MOBILE.matches && sidebar) {
      sidebar.setAttribute('inert', '');
    } else {
      sidebar?.removeAttribute('inert');
    }
    const btn = document.querySelector<HTMLButtonElement>('.topbar__toggle');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'Open navigation');
    init();
  });
</script>

<style>
  /* ---- Desktop: sticky sidebar inside the padded flex parent ---- */
  .sidebar {
    position: sticky;
    top: 75px;
    flex: 0 0 var(--sidebar-width);
    width: var(--sidebar-width);
    align-self: flex-start;
    max-height: calc(100vh - 150px);
    background: var(--color-bg);
    overflow-y: auto;
    z-index: 20;
    transition: background-color var(--duration) var(--ease);
  }
  .sidebar__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .sidebar__brand {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    transition: color 0.2s var(--ease);
  }
  .sidebar__brand[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav > li {
    margin-bottom: var(--space-3);
  }

  /* Top-level items (both <summary> and plain links) share one look. */
  .group > summary,
  .nav__top {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    list-style: none; /* hide default disclosure triangle */
    transition: color 0.2s var(--ease);
  }
  .group > summary::-webkit-details-marker {
    display: none;
  }
  .group > summary:hover,
  .nav__top:hover {
    color: var(--color-accent);
    opacity: 1;
  }
  .nav__top[aria-current='page'] {
    color: var(--color-accent);
  }

  .group[open] > summary {
    color: var(--color-accent);
  }

  .group__content {
    overflow: hidden;
  }
  .children {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding-left: var(--space-4);
  }
  .children li {
    margin-bottom: var(--space-2);
  }
  .children a {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-muted);
    transition: color 0.2s var(--ease);
  }
  .children a:hover {
    color: var(--color-text);
    opacity: 1;
  }
  .children a[aria-current='page'] {
    color: var(--color-accent);
  }

  /* ---- Mobile top bar ---- */
  .topbar {
    display: none;
    position: sticky;
    top: 0;
    z-index: 30;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    transition: background-color var(--duration) var(--ease);
  }
  .topbar__brand {
    font-weight: 700;
    color: var(--color-text);
    transition: color 0.2s var(--ease);
  }
  .topbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .topbar__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text);
    cursor: pointer;
  }
  /* Hamburger: middle bar + ::before/::after for top & bottom. */
  .topbar__bars,
  .topbar__bars::before,
  .topbar__bars::after {
    content: '';
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    transition:
      transform var(--nav-duration) var(--ease-drawer),
      opacity calc(var(--nav-duration) * 0.75) var(--ease-drawer),
      top var(--nav-duration) var(--ease-drawer);
  }
  .topbar__bars {
    position: relative;
  }
  .topbar__bars::before {
    position: absolute;
    top: -7px;
  }
  .topbar__bars::after {
    position: absolute;
    top: 7px;
  }
  /* Animate to an X when the nav is open. */
  :global(.nav-open) .topbar__bars {
    background: transparent;
  }
  :global(.nav-open) .topbar__bars::before {
    top: 0;
    transform: rotate(45deg);
  }
  :global(.nav-open) .topbar__bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 24;
    background: color-mix(in srgb, var(--color-text) 18%, transparent);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--nav-duration) var(--ease-drawer),
      visibility 0s linear var(--nav-duration-close);
  }

  @media (max-width: 1024px) {
    .topbar {
      display: flex;
    }
    .nav-backdrop {
      display: block;
    }
    .sidebar {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      max-height: none;
      z-index: 25;
      background: var(--color-bg);
      overflow-y: auto;
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path var(--nav-duration) var(--ease-drawer),
        visibility 0s linear var(--nav-duration-close);
    }
    .sidebar__header {
      display: none; /* brand + theme toggle live in the sticky top bar */
    }
    .sidebar__inner {
      min-height: 100%;
      padding: calc(var(--topbar-height) + var(--space-6)) var(--space-6) var(--space-6);
      opacity: 0;
      transform: translateY(-10px);
      transition:
        opacity calc(var(--nav-duration) * 0.85) var(--ease-drawer) 0.1s,
        transform var(--nav-duration) var(--ease-drawer) 0.08s;
    }
    :global(.nav-open) .nav-backdrop {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        opacity var(--nav-duration) var(--ease-drawer),
        visibility 0s linear 0s;
    }
    :global(.nav-open) .sidebar {
      visibility: visible;
      clip-path: inset(0 0 0 0);
      transition:
        clip-path var(--nav-duration) var(--ease-drawer),
        visibility 0s linear 0s;
    }
    :global(.nav-open) .sidebar__inner {
      opacity: 1;
      transform: translateY(0);
    }

    /* Drawer menu: larger, centered, tap-friendly items (mobile only) */
    .sidebar__nav {
      text-align: center;
    }
    .group > summary,
    .nav__top {
      font-size: var(--text-xl);
      padding: var(--space-2) 0;
    }
    .children {
      padding-left: 0;
    }
    .children li {
      margin-bottom: 0;
    }
    .children a {
      display: block;
      font-size: var(--text-lg);
      padding: var(--space-2) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-backdrop,
    .sidebar,
    .sidebar__inner,
    .topbar__bars,
    .topbar__bars::before,
    .topbar__bars::after {
      transition: none;
    }
  }
</style>
