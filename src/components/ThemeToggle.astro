<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Theme: System (click to switch to Light)"
>
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--system"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="13" rx="1"></rect>
    <path d="M8 21h8M12 17v4"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: none;
    border: none;
    border-radius: var(--radius);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .theme-toggle:hover {
    background: var(--color-border);
  }

  .theme-toggle__icon {
    width: 1.1rem;
    height: 1.1rem;
    display: none;
  }
  /* Default (no pref known yet, e.g. no-JS): show the system glyph. */
  .theme-toggle__icon--system {
    display: block;
  }

  :root[data-theme-pref='light'] .theme-toggle__icon--sun {
    display: block;
  }
  :root[data-theme-pref='light'] .theme-toggle__icon--system {
    display: none;
  }
  :root[data-theme-pref='dark'] .theme-toggle__icon--moon {
    display: block;
  }
  :root[data-theme-pref='dark'] .theme-toggle__icon--system {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>
