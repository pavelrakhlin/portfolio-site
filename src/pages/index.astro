---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects } from '../lib/projects';

const featured = await getFeaturedProjects();
---

<Base title="Your Name — Designer">
  <div class="container">
    <section class="intro">
      <h1 data-reveal>
        I design clear, human interfaces for products people rely on.
      </h1>
      <p class="intro__lede muted" data-reveal>
        Selected work is in the sidebar. I care about the details — and about
        the story behind each decision.
      </p>
    </section>

    {
      featured.length > 0 && (
        <section class="featured">
          <p class="section-label">Selected</p>
          <div class="grid" data-reveal-group>
            {featured.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .intro {
    max-width: 36rem;
    margin-bottom: var(--space-16);
  }
  .intro h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-6);
  }
  .intro__lede {
    font-size: var(--text-lg);
  }
  .section-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-8);
  }
</style>
