---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatSectionBody } from '../../lib/format-body';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const slug = Astro.params.slug!;
const project = await getEntry('projects', slug);
if (!project) {
  return Astro.redirect('/work/');
}

const { title, summary, role, year, tags, cover, coverMedia, coverAlt, metrics, sections } =
  project.data;
const { Content } = await render(project);

// Collapse legacy image-only sections into the `media` shape so the markup
// below has a single code path. `as const` keeps the discriminated union
// narrowing intact.
const normalized = sections.map((s) =>
  s.media
    ? s
    : s.image && s.imageAlt
      ? { ...s, media: { type: 'image' as const, src: s.image, alt: s.imageAlt } }
      : s,
);
---

<Base title={`${title} — Pavel R`} description={summary}>
  <article class="container case-study">
    <header class="case-head">
      <h1
        class="case-head__title"
        data-reveal-lines
        data-line-base-delay="0.1"
        data-line-stagger="0.09"
      >
        {summary}
      </h1>

      <dl class="info-row reveal-block" data-reveal-scroll>
        <div class="info-row__item">
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        {
          tags.length > 0 && (
            <div class="info-row__item">
              <dt>Discipline</dt>
              <dd>{tags.join(', ')}</dd>
            </div>
          )
        }
        <div class="info-row__item">
          <dt>Year</dt>
          <dd>{year}</dd>
        </div>
      </dl>
    </header>

    <div class="case-hero reveal-block" data-reveal-scroll>
      {
        coverMedia?.type === 'video' ? (
          <button
            class="media-trigger"
            data-lightbox
            data-media="video"
            data-alt={coverMedia.alt}
            aria-label={`Enlarge video: ${coverMedia.alt}`}
          >
            <video
              class="case-hero__video"
              poster={coverMedia.poster.src}
              preload="metadata"
              muted
              loop
              playsinline
              aria-label={coverMedia.alt}
              data-autoplay-video
            >
              {coverMedia.webm && (
                <source src={coverMedia.webm} type="video/webm" />
              )}
              <source src={coverMedia.mp4} type="video/mp4" />
            </video>
          </button>
        ) : (
          <button
            class="media-trigger"
            data-lightbox
            data-alt={coverAlt}
            aria-label={`Enlarge image: ${coverAlt}`}
          >
            <Image
              src={cover}
              alt={coverAlt}
              widths={[640, 1024, 1600]}
              sizes="(max-width: 1088px) 100vw, 1088px"
              loading="eager"
              decoding="sync"
              fetchpriority="high"
            />
          </button>
        )
      }
    </div>

    {
      metrics && metrics.length > 0 && (
        <>
          <dl class="case-metrics reveal-block" data-reveal-scroll>
            {metrics.map((metric) => (
              <div class="case-metrics__item">
                <dt class="case-metrics__value">{metric.value}</dt>
                <dd class="case-metrics__label">{metric.label}</dd>
              </div>
            ))}
          </dl>
          <hr class="section-divider metrics-divider" />
        </>
      )
    }

    {
      normalized.length > 0 ? (
        <div class="sections">
          {normalized.map((section) => (
            <>
              {section.dividerBefore && <hr class="section-divider" />}
              <section class="section">
              {section.body.trim() && (
                <div class="section__text reveal-block" data-reveal-scroll>
                  <h2>{section.heading}</h2>
                  <div class="section__body" set:html={formatSectionBody(section.body)} />
                </div>
              )}
              {section.media && (
              <div class="section__media reveal-block" data-reveal-scroll>
                {section.media.type === 'image' && (
                  <button
                    class="media-trigger"
                    data-lightbox
                    data-alt={section.media.alt}
                    aria-label={`Enlarge image: ${section.media.alt}`}
                  >
                    <Image
                      src={section.media.src}
                      alt={section.media.alt}
                      widths={[640, 1024, 1280]}
                      sizes="(max-width: 768px) 100vw, 1190px"
                    />
                  </button>
                )}

                {section.media.type === 'gif' && (
                  /* Plain <img> (NOT astro:assets) so the animation survives. */
                  <button
                    class="media-trigger"
                    data-lightbox
                    data-alt={section.media.alt}
                    aria-label={`Enlarge image: ${section.media.alt}`}
                  >
                    <img
                      src={section.media.src}
                      alt={section.media.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                )}

                {section.media.type === 'video' && (
                  /* No `autoplay` attr — JS plays it on scroll-in only when
                     reduced-motion is off. Poster shows for everyone first. */
                  <button
                    class="media-trigger"
                    data-lightbox
                    data-media="video"
                    data-alt={section.media.alt}
                    aria-label={`Enlarge video: ${section.media.alt}`}
                  >
                    <video
                      class="section__video"
                      poster={section.media.poster.src}
                      preload="metadata"
                      muted
                      loop
                      playsinline
                      aria-label={section.media.alt}
                      data-autoplay-video
                    >
                      {section.media.webm && (
                        <source src={section.media.webm} type="video/webm" />
                      )}
                      <source src={section.media.mp4} type="video/mp4" />
                    </video>
                  </button>
                )}
              </div>
              )}
            </section>
            </>
          ))}
        </div>
      ) : (
        <div class="prose case-body reveal-block" data-reveal-scroll>
          <Content />
        </div>
      )
    }
  </article>
</Base>

<style>
  .case-head {
    margin-bottom: var(--space-12);
  }
  .case-head__title {
    width: 100%;
    max-width: none;
    margin-bottom: var(--space-8);
  }

  /* Info row: Role · Discipline · Year — all inline or all stacked. */
  .info-row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: var(--space-12);
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .info-row--stacked {
    flex-direction: column;
    gap: var(--space-4);
  }
  .info-row:not(.info-row--stacked) .info-row__item {
    flex-shrink: 0;
    white-space: nowrap;
  }
  .info-row__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .info-row dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .info-row dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .case-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
    margin: 0;
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .case-metrics__item {
    margin: 0;
  }
  .case-metrics__value {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2);
  }
  .case-metrics__label {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .case-metrics {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .metrics-divider {
    margin: 0 0 var(--space-16);
  }

  /* Layout-neutral button wrapper so media stays clickable + keyboard-
     accessible without changing how it renders. */
  .media-trigger {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
  }

  .case-hero img,
  .case-hero video {
    width: 100%;
    border-radius: 0;
    margin-bottom: var(--space-16);
    display: block;
  }
  /* Reserve hero space while the reveal block is hidden. */
  .case-hero.reveal-block[data-reveal-scroll]:not(.is-revealed) {
    min-height: clamp(12rem, 56vw, 28rem);
  }

  /* Stacked text + full-width image sections. Even spacing around each text
     block is handled by .section__text's symmetric margin-block, so the
     container itself adds no gap. */
  .sections {
    display: flex;
    flex-direction: column;
  }
  .section-divider {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }
  /* Inline header + body: heading on the left, body copy on the right.
     Equal top/bottom margin keeps each text block evenly spaced between the
     media above and below it. */
  .section__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-12);
    align-items: start;
    margin-block: var(--space-16);
  }
  .section__text h2 {
    font-size: var(--text-2xl);
    margin: 0;
  }
  .section__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--max-width-prose);
  }
  .section__body p {
    color: var(--color-text);
    margin: 0;
    font-size: 16px;
  }

  /* Stack heading above body on narrow screens. */
  @media (max-width: 768px) {
    .section__text {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
  .section__media img,
  .section__media video {
    width: 100%;
    border-radius: 0;
    display: block;
  }
</style>
