---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, role, year, tags, cover, coverAlt, sections } =
  project.data;
const { Content } = await render(project);
---

<Base title={`${title} — Your Name`} description={summary}>
  <article class="container">
    <header class="case-head">
      <h1 data-reveal>{title}</h1>
      <p class="case-head__summary muted" data-reveal>{summary}</p>

      <dl class="info-row" data-reveal>
        <div class="info-row__item">
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        {
          tags.length > 0 && (
            <div class="info-row__item">
              <dt>Discipline</dt>
              <dd>{tags.join(', ')}</dd>
            </div>
          )
        }
        <div class="info-row__item">
          <dt>Year</dt>
          <dd>{year}</dd>
        </div>
      </dl>
    </header>

    <div class="case-hero" data-reveal>
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 1024, 1600]}
        sizes="(max-width: 1088px) 100vw, 1088px"
        transition:name={`cover-${project.id}`}
      />
    </div>

    {
      sections.length > 0 ? (
        <div class="sections">
          {sections.map((section) => (
            <section class="section" data-reveal-group>
              <div class="section__text">
                <h2>{section.heading}</h2>
                <p>{section.body}</p>
              </div>
              <div class="section__media">
                <Image
                  src={section.image}
                  alt={section.imageAlt}
                  widths={[640, 1024, 1280]}
                  sizes="(max-width: 768px) 100vw, 1190px"
                />
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="prose case-body">
          <Content />
        </div>
      )
    }
  </article>
</Base>

<style>
  .case-head {
    margin-bottom: var(--space-12);
  }
  .case-head h1 {
    margin-bottom: var(--space-3);
  }
  .case-head__summary {
    font-size: var(--text-lg);
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-8);
  }

  /* Info row: Role · Discipline · Year */
  .info-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .info-row__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .info-row dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .info-row dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .case-hero img {
    width: 100%;
    border-radius: 0;
    margin-bottom: var(--space-16);
  }

  /* Stacked text + full-width image sections */
  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .section__text {
    max-width: var(--max-width-prose);
    margin-bottom: var(--space-8);
  }
  .section__text h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }
  .section__text p {
    color: var(--color-muted);
    margin: 0;
  }
  .section__media img {
    width: 100%;
    border-radius: 0;
  }
</style>
